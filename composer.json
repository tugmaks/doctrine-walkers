{
    "name": "tugmaks/doctrine-walkers",
    "description": "Doctrine ORM output walkers adding support for DISTINCT ON, FILTER (WHERE ...), FOR UPDATE, NULLS FIRST / NULLS LAST, RETURNING, TABLESAMPLE and WITH TIES.",
    "license": [
        "MIT"
    ],
    "type": "library",
    "keywords": [
        "doctrine walker",
        "output walker",
        "doctrine",
        "distinct on",
        "filter where",
        "for update",
        "nulls first",
        "nulls last",
        "returning",
        "skip locked",
        "tablesample",
        "with ties"
    ],
    "authors": [
        {
            "name": "Maxim Tyugaev",
            "email": "tugmaks@yandex.ru"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/php-cs-fixer-config": "^6.64",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.8",
        "vimeo/psalm": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Tugmaks\\DoctrineWalkersTest\\": "tests/",
            "Tugmaks\\DoctrineWalkers\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
